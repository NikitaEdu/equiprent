digraph G { graph [fontname="Liberation Serif", pad=0.15, nodesep=0.4, ranksep=0.4]; node [fontname="Liberation Serif", fontsize=14, shape=box, style="rounded", penwidth=1.3, margin="0.14,0.07"]; edge [fontname="Liberation Serif", fontsize=12.5, penwidth=1.1, arrowsize=0.7]; rankdir=TB;
  user [label="Клієнт / менеджер\n[людина]", shape=box, style="rounded,filled", fillcolor="#f2f2f2"];
  subgraph cluster_sys { label="Вебсистема EquipRent"; fontname="Liberation Serif"; fontsize=14; style="rounded,dashed";
    spa [label="Клієнтський застосунок\n[React, TypeScript]\nсторінки, календар, стан форм"];
    api [label="Серверний застосунок\n[Spring Boot, Java 21]\nREST API, автентифікація, права,\nбізнес-правила бронювання"];
    db [label="База даних\n[PostgreSQL 16]\nсхема, обмеження EXCLUDE, історія", shape=cylinder, style=""];
  }
  user -> spa [label="використовує\n(браузер)"];
  spa -> api [label="JSON / HTTPS;\ncookie сесії + X-XSRF-TOKEN"];
  api -> spa [label="статичні файли\nінтерфейсу", style=dashed];
  api -> db [label="JDBC (SQL);\nтранзакції, блокування"];
}
