digraph G {
  graph [fontname="Liberation Serif", nodesep=0.45, ranksep=0.3, pad=0.15];
  node  [fontname="Liberation Serif", fontsize=14, shape=box, style="rounded,filled", fillcolor=white, penwidth=1.3, margin="0.14,0.06"];
  edge  [fontname="Liberation Serif", fontsize=13, penwidth=1.1, arrowsize=0.7];
  start [label="Початок", fillcolor="#eeeeee"];
  in    [label="Тип, дати, коментар;\nкористувач — із сесії", shape=parallelogram, style=filled, fixedsize=false, width=2.6];
  role  [label="Роль —\nклієнт?", shape=diamond, margin="0.02,0.02"];
  e403  [label="403: бронюють\nлише клієнти", style=filled, fillcolor="#f5f5f5", shape=box];
  period[label="Період\nдопустимий?", shape=diamond, margin="0.02,0.02"];
  e400  [label="400: помилка\nперіоду з поясненням", style=filled, fillcolor="#f5f5f5", shape=box];
  quote [label="Розрахувати вартість\nза формулами (2.3)–(2.5)"];
  atom  [label="Атомарне створення\n(рис. 2.2)", peripheries=2, shape=box];
  res   [label="Повернути результат:\n201 / 409 / 500"];
  end   [label="Кінець", fillcolor="#eeeeee"];
  start -> in -> role;
  role -> e403 [label="Ні"]; role -> period [label="Так"];
  period -> e400 [label="Ні"]; period -> quote [label="Так"];
  quote -> atom -> res -> end;
  e403 -> end; e400 -> end;
  {rank=same; role; e403} {rank=same; period; e400}
}
