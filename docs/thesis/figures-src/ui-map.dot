digraph G { graph [fontname="Liberation Serif", pad=0.15, nodesep=0.4, ranksep=0.4]; node [fontname="Liberation Serif", fontsize=17, shape=box, style="rounded", penwidth=1.3, margin="0.14,0.07"]; edge [fontname="Liberation Serif", fontsize=15.5, penwidth=1.1, arrowsize=0.7]; rankdir=TB;
